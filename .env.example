# Copy thành .env rồi điền. App kiểm tra env lúc khởi động và dừng ngay nếu thiếu/sai.

# ===== BẮT BUỘC =====
# local | test | production. Khi deploy đặt production (bắt buộc có META_APP_SECRET bên dưới).
NODE_ENV=local
PORT=3000
# Origin công khai, dùng cho kiểm tra Origin và URL webhook (không có dấu / ở cuối).
# Khi deploy: https://ten-mien-cua-ban
APP_URL=http://localhost:3000
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/bv_agent_msg

# Key mã hoá credential (API key LLM, token kênh). 32 byte, base64: openssl rand -base64 32
# Mất hoặc đổi key này thì không giải mã được credential đã lưu: sao lưu cẩn thận.
CREDENTIAL_KEY=REPLACE_ME_WITH_openssl_rand_base64_32
CREDENTIAL_KEY_ID=v1

# ===== BẮT BUỘC KHI DEPLOY =====
# Mã để tạo admin đầu tiên tại /admin/setup. Để trống = chỉ setup được từ máy local (127.0.0.1).
SETUP_TOKEN=

# App Secret của Meta App dùng chung. Bắt buộc khi NODE_ENV=production.
# Dùng cho WhatsApp và kênh Messenger chưa có appSecret riêng
# (mỗi tenant tự kết nối Meta App riêng tại /app → Kênh).
META_APP_SECRET=

# ===== TUỲ CHỌN (giá trị dưới đây là mặc định) =====
# AI provider và API key quản lý tại /admin → AI provider, không đặt ở đây.
LLM_TIMEOUT_MS=20000
LLM_MAX_TOKENS=1024

# Cho phép khách tự đăng ký tenant dùng thử tại /app/register. Giữ false trừ khi muốn mở đăng ký.
ALLOW_SIGNUP=false
SIGNUP_TRIAL_DAYS=14

LOG_LEVEL=info
# false = không chạy worker gửi tin (outbox) trong tiến trình này.
WORKER_ENABLED=true

# Chỉ khi dùng kênh Zalo OA: App ID dùng để kiểm tra chữ ký webhook Zalo.
# ZALO_APP_ID=

# Chỉ seed bảng AI provider khi bảng còn trống (lần chạy đầu); sau đó bị bỏ qua. Xem README.
# LLM_PROVIDERS=[{"name":"gemini-free","baseUrl":"https://generativelanguage.googleapis.com/v1beta/openai","model":"gemini-3.5-flash-lite","apiKey":""}]
