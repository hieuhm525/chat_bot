# --- Core ---
NODE_ENV=local
PORT=3000
# Public origin used for Origin checks and webhook URLs (no trailing slash).
APP_URL=http://localhost:3000
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/bv_agent_msg

# 32-byte key, base64. Generate: openssl rand -base64 32
# Required at boot: credentials cannot be encrypted without it.
CREDENTIAL_KEY=REPLACE_ME_WITH_openssl_rand_base64_32
CREDENTIAL_KEY_ID=v1

# --- Free AI models (OpenAI-compatible providers, tried in order) ---
# Chỉ dùng để seed bảng llm_providers khi bảng còn trống (lần chạy đầu).
# Sau đó quản lý provider/key tại /admin → AI provider; sửa env không có tác dụng.
# Leave [] to run rule-only. Every entry is optional; the first healthy one answers.
# Free options (no paid key needed):
#   OpenRouter free models  https://openrouter.ai/api/v1        (key from openrouter.ai/keys)
#   Groq free tier          https://api.groq.com/openai/v1      (key from console.groq.com)
#   Google Gemini free tier https://generativelanguage.googleapis.com/v1beta/openai
#   Ollama (local, no key)  http://localhost:11434/v1
LLM_PROVIDERS=[{"name":"openrouter-free","baseUrl":"https://openrouter.ai/api/v1","model":"meta-llama/llama-3.3-70b-instruct:free","apiKey":""},{"name":"gemini-free","baseUrl":"https://generativelanguage.googleapis.com/v1beta/openai","model":"gemini-3.5-flash-lite","apiKey":""},{"name":"ollama-local","baseUrl":"http://localhost:11434/v1","model":"qwen2.5:3b","apiKey":""}]
LLM_TIMEOUT_MS=20000
LLM_MAX_TOKENS=1024

# --- Meta app (Messenger + WhatsApp webhook signature) ---
META_APP_SECRET=
META_VERIFY_TOKEN=doi-mot-chuoi-ngau-nhien

# --- Zalo app (P5) ---
ZALO_APP_ID=
ZALO_APP_SECRET=

# Mã để tạo admin đầu tiên tại /admin/setup. Đặt trước khi deploy.
# Để trống = chỉ cho phép setup từ máy local (127.0.0.1).
SETUP_TOKEN=

# --- Optional ---
LOG_LEVEL=info
# Cho phép khách tự đăng ký tenant dùng thử tại /app/register (mặc định tắt).
ALLOW_SIGNUP=false
SIGNUP_TRIAL_DAYS=14
WORKER_ENABLED=true
