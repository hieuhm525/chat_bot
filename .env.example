# --- Lõi ---
APP_ENV=local
SHOP_NAME=Cửa hàng của bạn
DB_PATH=chat.db
FAQ_PATH=faq.md
MAX_TOKENS=300

# local: bật mock UI + gửi giả. production: tắt cả hai.
ENABLE_MOCK_UI=true
ENABLE_SWEEPER=1

# Mật khẩu vào /admin (để trống = tắt trang quản trị)
ADMIN_PASSWORD=

# --- LLM (chuẩn OpenAI-compatible) ---
# OpenAI
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Gemini (OpenAI-compatible)
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-3.5-flash-lite
# OpenRouter (dùng được Claude, Llama, ...)
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=anthropic/claude-3.5-haiku
# Ollama (offline, key để trống hoặc bất kỳ)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:3b

LLM_API_KEY=

# --- Messenger (chỉ cần khi chạy production) ---
SEND_MODE=mock

# PAGE_TOKEN = Page access token (access token dùng để gọi Graph API).
# Lấy tại: https://developers.facebook.com/apps -> chọn app -> Messenger -> Settings
#          -> Access Tokens -> chọn đúng Page -> Generate token.
# Dùng long-lived Page token; không dùng user token hay app token.
PAGE_TOKEN=

# APP_SECRET: https://developers.facebook.com/apps -> app -> App settings -> Basic
#              -> App secret -> Show.
APP_SECRET=

# VERIFY_TOKEN: chuỗi tự đặt. Nhập đúng giá trị này ở
# Messenger -> Settings -> Webhooks -> Verify token.
VERIFY_TOKEN=doi-mot-chuoi-ngau-nhien

# Webhook callback URL khai báo ở Messenger -> Settings -> Webhooks:
#   https://<domain-cua-ban>/webhook
# Subscribe các field: messages, messaging_postbacks.
GRAPH_VERSION=v26.0
